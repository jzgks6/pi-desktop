{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi desktop",
  "version": "0.9.3",
  "identifier": "com.piweb.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "pi desktop",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": ["runtime/"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
